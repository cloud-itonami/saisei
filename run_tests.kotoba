#!/usr/bin/env kbb
;; saisei — bb-native test runner (Clojure / babashka; no shell). ADR-2607061800 + ADR-2606072802.
;; Per the repo-wide rule (root AGENTS.md §"Operational code = clj/bb"): first-party
;; tooling is clj/bb, NOT shell. New actors ship run_tests.clj, not run_tests.sh.
;;
;;   kbb run_tests.cljk      ; run from anywhere
(require '[babashka.classpath :as cp]
         '[babashka.fs :as fs]
         '[clojure.test :as t])

;; The repository root is the classpath root for the `saisei.*` namespaces.
(cp/add-classpath (str (fs/parent (fs/absolutize *file*))))

(def suites '[saisei.tests.test-filing-plan
              saisei.tests.test-coverage])

(apply require suites)

(let [{:keys [fail error]} (apply t/run-tests suites)]
  (System/exit (if (zero? (+ fail error)) 0 1)))
